# ─────────────────────────────────────────────────────────────────────────────
# SignalFold — Environment variable template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Nebius Token Factory ──────────────────────────────────────────────────────
# Obtain from: https://studio.nebius.ai/settings/api-keys
NEBIUS_API_KEY=your_nebius_api_key_here

# Base URL for the Nebius OpenAI-compatible endpoint
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# NVIDIA Nemotron model ID (check Nebius catalog for the exact identifier)
NEBIUS_MODEL_ID=nvidia/llama-3.1-nemotron-70b-instruct

# ── Tavily Search API ─────────────────────────────────────────────────────────
# Obtain from: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ── Backend configuration ─────────────────────────────────────────────────────
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to backend/)
DATABASE_PATH=./signalfold.db
